    "ChatScreen.chat_ended_message_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your previous chat is closed by Philips now. Please be aware that the conversation will be deleted after 30 days after the chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su chat anterior ha sido cerrado por Philips. Por favor, tenga en cuenta que la conversación será eliminada a los 30 días de la conversación."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu chat anterior foi encerrado pela Philips. Tenha em atenção que a conversa será eliminada 30 dias após o chat."
          }
        },
        "es-PR" : {
          "stringUnit" : {
            "state" : "translated",
